{
    "name": "pyhp/starter",
    "description": "A starter project for PHP apps that use Python libraries (pandas, matplotlib, ...) through PyHP.",
    "type": "project",
    "license": "MIT",
    "keywords": ["pyhp", "python", "pandas", "starter"],
    "homepage": "https://github.com/pyhp-php/starter",
    "require": {
        "php": "^8.2",
        "pyhp/pyhp": "^0.3"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php vendor/bin/pyhp setup"
        ],
        "setup": "@php vendor/bin/pyhp setup --exact",
        "info": "@php vendor/bin/pyhp info",
        "test": "pest",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public"
        ]
    },
    "extra": {
        "pyhp": {
            "python": "3.12",
            "requirements": ["pandas>=2.2", "matplotlib>=3.8"]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
